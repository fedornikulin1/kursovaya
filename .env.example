# Local development
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Required with DEBUG=false. Generate a unique random value; never commit .env.
SECRET_KEY=
# Empty means local SQLite. PostgreSQL example:
# DATABASE_URL=postgresql://uniboard:password@localhost:5432/uniboard
DATABASE_URL=
# Optional: local Docker Compose PostgreSQL password.
POSTGRES_PASSWORD=
CSRF_TRUSTED_ORIGINS=
# Enable only behind a trusted proxy (e.g. Render) that overwrites forwarded headers.
TRUST_PROXY=false

# Photo storage: empty bucket means local media/.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=

# Email is printed to the terminal locally. Set SMTP in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@localhost
